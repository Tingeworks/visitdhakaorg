{
	// Type-checks the Worker's source against the Workers runtime (worker-configuration.d.ts, generated by `pnpm check` and not committed).
	// Tests run on Node with its own types and aren't included here.
	"compilerOptions": {
		"target": "es2024",
		"module": "esnext",
		"moduleResolution": "bundler",
		"lib": ["es2024"],
		"types": ["./worker-configuration.d.ts"],
		"strict": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		// Only TypeScript that Node can strip, since the tests run the source directly.
		"erasableSyntaxOnly": true,
		"skipLibCheck": true
	},
	"include": ["src"]
}
