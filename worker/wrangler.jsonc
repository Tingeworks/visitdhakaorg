// The edit Worker: its own Cloudflare project, deployed from `main` with root directory `worker/` (#14), and served on
// visitdhaka.org/api/* so the editor calls it on the site's own origin (decision 0002). Secrets are never in this
// file: set them with `npx wrangler secret put <NAME>` or in the dashboard (#10).
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "visitdhaka-edit",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-15",
	"observability": { "enabled": true },
	// GITHUB_APP_ID, GITHUB_INSTALLATION_ID, DAILY_EDIT_CAP and SIGN_IN_ENABLED are managed in the dashboard (#10, #55).
	// Keep DAILY_EDIT_CAP and SIGN_IN_ENABLED out of vars so a deploy cannot reopen editing after the kill switch is set
	// to 0, or switch sign-in back on after it was turned off (#35).
	"keep_vars": true,
	"vars": {
		"GITHUB_OWNER": "Tingeworks",
		"GITHUB_REPO": "visitdhakaorg",
		"GITHUB_BASE_BRANCH": "main",
		"ALLOWED_ORIGIN": "https://visitdhaka.org"
	},
	// Accounts for optional Google sign-in (decision 0006, #55). Tables come from worker/migrations/, applied with
	// `npx wrangler d1 migrations apply visitdhaka-edit --remote` (or `--local` for `pnpm dev`), run from worker/.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "visitdhaka-edit",
			"database_id": "a5513ef4-95b6-458f-a1c1-a44840a5576e",
			"migrations_dir": "migrations"
		}
	],
	// Only /api/* reaches the Worker. Every other path on visitdhaka.org is served by the site project (#14).
	"routes": [{ "pattern": "visitdhaka.org/api/*", "zone_name": "visitdhaka.org" }]
}
