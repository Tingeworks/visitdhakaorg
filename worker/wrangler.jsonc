// The edit Worker: its own Cloudflare project, deployed from `main` with root directory `worker/` (#14), and served on
// visitdhaka.org/api/* so the editor calls it on the site's own origin (decision 0002). Secrets are never in this
// file: set them with `npx wrangler secret put <NAME>` or in the dashboard (#10).
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "visitdhaka-edit",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-15",
	"observability": { "enabled": true },
	// GITHUB_APP_ID, GITHUB_INSTALLATION_ID and DAILY_EDIT_CAP are managed in the dashboard (#10).
	// Keep DAILY_EDIT_CAP out of vars so a deploy cannot reopen editing after the kill switch is set to 0 (#35).
	"keep_vars": true,
	"vars": {
		"GITHUB_OWNER": "Tingeworks",
		"GITHUB_REPO": "visitdhakaorg",
		"GITHUB_BASE_BRANCH": "main",
		"ALLOWED_ORIGIN": "https://visitdhaka.org"
	}
	// The visitdhaka.org/api/* route is added in #14, once the domain is on Cloudflare.
}
