---
// The in-site editor, at /edit/?path=<source file> and /bn/edit/?path=..., opened from "Edit page" when
// PUBLIC_EDITOR_ENABLED is on (src/components/EditLink.astro). It loads the page's Markdown from the edit Worker
// (GET /api/source) and sends the edit back (POST /api/edit), which turns it into a pull request for review. It needs no
// GitHub account. Turnstile, the only third-party script, loads only here and only once the page text has loaded.
// With PUBLIC_SIGN_IN_ENABLED, it also offers optional Google sign-in (#59): a plain link to the Worker's
// /api/auth/login, so nothing loads from Google until someone follows it. Renaming, signing out and deleting the
// account are on the account page (/account/).
// The form works with the keyboard alone, and every message comes from en.json and bn.json.
import type { GetStaticPaths } from 'astro';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import AccountNameForm from '../../components/AccountNameForm.astro';
import { editApiUrl, editorEnabled, signInEnabled, turnstileSiteKey } from '../../lib/editor';
import { localizePath, translatedLocales } from '../../lib/i18n';
import '../../styles/edit-form.css';

export const getStaticPaths = (() =>
	[undefined, ...translatedLocales].map((locale) => ({ params: { locale } }))) satisfies GetStaticPaths;

const { locale } = Astro.params;
const { t } = Astro.locals;
const enabled = editorEnabled && Boolean(turnstileSiteKey);

// Escape opening angle brackets so translated text cannot close the JSON script element.
const messageKeys = [
	'edit.editing',
	'edit.loadFailed',
	'edit.notEditable',
	'edit.notFound',
	'edit.pendingLink',
	'edit.submit',
	'edit.submitting',
	'edit.successLink',
	'edit.reload',
	'edit.error.stale',
	'edit.error.conflict',
	'edit.error.turnstile',
	'edit.error.turnstile_failed',
	'edit.error.daily_cap_reached',
	'edit.error.rate_limited',
	'edit.error.request_too_large',
	'edit.error.body_too_large',
	'edit.error.diff_too_large',
	'edit.error.body_has_html',
	'edit.error.body_has_mdx',
	'edit.error.body_has_unsafe_link',
	'edit.error.body_has_external_image',
	'edit.error.body_has_frontmatter',
	'edit.error.body_has_control_characters',
	'edit.error.no_change',
	'edit.error.name_too_long',
	'edit.error.name_has_link',
	'edit.error.summary_too_long',
	'edit.error.licence_required',
	'edit.error.name_required',
	'edit.error.name_reserved',
	'edit.error.name_has_email',
	'edit.error.banned',
	'edit.error.signed_out',
	'edit.signedInAs',
	'edit.contributions',
	'edit.error.network',
	'edit.error.generic',
] as const;
const messages = Object.fromEntries(
	messageKeys.map((key) => [key, t(key, { title: '{{title}}', name: '{{name}}', interpolation: { escapeValue: false } })]),
);
const messagesJson = JSON.stringify(messages).replace(/</g, '\\u003c');
// Placeholders the script fills in, kept as {{name}} so it can swap them for links.
const pendingText = t('edit.pending', { link: '{{link}}', interpolation: { escapeValue: false } });
const successText = t('edit.successText', { link: '{{link}}', interpolation: { escapeValue: false } });

const github = '<a href="https://github.com/Tingeworks/visitdhakaorg">GitHub</a>';
const disabledText = t('edit.disabled', { link: github, interpolation: { escapeValue: false } });
const licenceText = t('edit.licence', {
	link: `<a href="${localizePath('/licence/', locale)}">CC BY-SA 4.0</a>`,
	interpolation: { escapeValue: false },
});
---

<StarlightPage
	frontmatter={{ title: t('edit.title'), description: t('edit.description'), editUrl: false, pagefind: false, prev: false, next: false }}
>
	{
		!enabled ? (
			<p set:html={disabledText} />
		) : (
			<div
				class="editor vd-form"
				id="editor"
				data-api={editApiUrl}
				data-sitekey={turnstileSiteKey}
				data-locale={locale ?? ''}
				data-pending={pendingText}
				data-success={successText}
				data-sign-in={signInEnabled ? 'true' : undefined}
				data-contributors={localizePath('/contributors/', locale)}
			>
				<p id="edit-status" role="status">
					{t('edit.loading')}
				</p>
				<div id="edit-alert" class="alert" role="alert" tabindex="-1" hidden>
					<p id="edit-alert-text" />
					<button type="button" id="edit-reload" hidden>
						{t('edit.reload')}
					</button>
				</div>

				{
					signInEnabled && (
						<section id="edit-choose-name" class="choose-name" aria-labelledby="edit-choose-name-title" hidden>
							<h2 id="edit-choose-name-title" tabindex="-1">
								{t('edit.chooseNameTitle')}
							</h2>
							<AccountNameForm>
								<button type="button" id="edit-skip-name" class="secondary">
									{t('edit.skipSignIn')}
								</button>
							</AccountNameForm>
						</section>
					)
				}

				{
					signInEnabled && (
						<div id="edit-account" class="account" hidden>
							<p id="edit-signed-out" hidden>
								{t('edit.signInPrompt')} <a id="edit-sign-in" href="#">{t('edit.signIn')}</a>
							</p>
							<div id="edit-signed-in" hidden>
								<p id="edit-signed-in-as" class="signed-in-as" tabindex="-1" />
								<p id="edit-contributions" class="hint">
									{t('edit.contributionsPending')}
								</p>
								<p>
									<a id="edit-manage-account" href={localizePath('/account/', locale)}>
										{t('edit.manageAccount')}
									</a>
								</p>
							</div>
						</div>
					)
				}

				<form id="edit-form" novalidate hidden>
					<h2 id="edit-heading" />
					<p id="edit-pending" class="pending" hidden />
					<p class="rules">{t('edit.rules')}</p>

					<div class="field">
						<label for="edit-body">{t('edit.bodyLabel')}</label>
						<textarea id="edit-body" name="body" rows="24" spellcheck="true" aria-describedby="edit-body-error" />
						<p id="edit-body-error" class="field-error" hidden />
					</div>

					<div class="field" id="edit-name-field">
						<label for="edit-name">{t('edit.nameLabel')}</label>
						<input id="edit-name" name="name" type="text" autocomplete="nickname" aria-describedby="edit-name-hint edit-name-error" />
						<p id="edit-name-hint" class="hint">
							{t('edit.nameHint')}
						</p>
						<p id="edit-name-error" class="field-error" hidden />
					</div>

					<div class="field">
						<label for="edit-summary">{t('edit.summaryLabel')}</label>
						<input id="edit-summary" name="summary" type="text" aria-describedby="edit-summary-hint edit-summary-error" />
						<p id="edit-summary-hint" class="hint">
							{t('edit.summaryHint')}
						</p>
						<p id="edit-summary-error" class="field-error" hidden />
					</div>

					<div class="field checkbox">
						<input id="edit-licence" name="licence" type="checkbox" required aria-describedby="edit-licence-error" />
						<label for="edit-licence" set:html={licenceText} />
						<p id="edit-licence-error" class="field-error" hidden />
					</div>

					<fieldset class="field">
						<legend>{t('edit.securityCheck')}</legend>
						<div id="edit-turnstile" />
						<p id="edit-turnstile-error" class="field-error" hidden />
					</fieldset>

					<div class="actions">
						<button type="submit" id="edit-submit">
							{t('edit.submit')}
						</button>
						<a id="edit-cancel" href={localizePath('/', locale)}>
							{t('edit.cancel')}
						</a>
					</div>
				</form>

				<section id="edit-success" class="success" tabindex="-1" hidden>
					<h2>{t('edit.successTitle')}</h2>
					<p id="edit-success-text" />
					<p>
						<a id="edit-back" href={localizePath('/', locale)}>
							{t('edit.backToPage')}
						</a>
					</p>
				</section>
			</div>
		)
	}
	{enabled && <script type="application/json" id="edit-messages" set:html={messagesJson} />}

</StarlightPage>

<script>
	import '../../scripts/editor';
</script>
