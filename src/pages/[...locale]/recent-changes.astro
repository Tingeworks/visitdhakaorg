---
// Recent changes, at /recent-changes/ and /bn/recent-changes/: the latest commits to pages, grouped by day in Dhaka time,
// newest first. Built from git at build time (src/lib/changes.ts), so it updates on every deploy and needs no JavaScript.
// A signed-in edit's author links to their contributor profile (#62).
import type { GetStaticPaths } from 'astro';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import ChangeList from '../../components/ChangeList.astro';
import { recentChanges, repoUrl } from '../../lib/changes';
import { translatedLocales } from '../../lib/i18n';

export const getStaticPaths = (() =>
	[undefined, ...translatedLocales].map((locale) => ({ params: { locale } }))) satisfies GetStaticPaths;

const { locale } = Astro.params;
const { t } = Astro.locals;
const changes = recentChanges();

const intro = t('recentChanges.intro', {
	link: `<a href="${repoUrl}/commits/main/src/content/docs">GitHub</a>`,
	interpolation: { escapeValue: false },
});
---

<StarlightPage frontmatter={{ title: t('recentChanges.title'), description: t('recentChanges.description') }}>
	<p set:html={intro} />
	{changes.length === 0 && <p>{t('recentChanges.empty')}</p>}
	<ChangeList changes={changes} locale={locale} variant="recent" />
</StarlightPage>
