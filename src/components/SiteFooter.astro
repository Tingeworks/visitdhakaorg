---
import { localeOf, localizePath } from '../lib/i18n';

const { t } = Astro.locals;
const locale = localeOf(Astro.url);

// Mirrors the sidebar groups in astro.config.mjs. Site paths are written in English and get the locale prefix below.
const columns = [
	{
		title: t('nav.explore'),
		links: [
			{ label: t('section.whatsOn'), href: '/whats-on/' },
			{ label: t('section.areas'), href: '/areas/' },
			{ label: t('section.attractions'), href: '/attractions/' },
			{ label: t('section.culture'), href: '/culture/' },
			{ label: t('section.shopping'), href: '/shopping/' },
			{ label: t('section.dayTrips'), href: '/day-trips/' },
		],
	},
	{
		title: t('footer.eatStay'),
		links: [
			{ label: t('section.food'), href: '/food/' },
			{ label: t('section.whereToStay'), href: '/where-to-stay/' },
		],
	},
	{
		title: t('nav.plan'),
		links: [
			{ label: t('section.gettingAround'), href: '/getting-around/' },
			{ label: t('section.practicalInfo'), href: '/practical-info/' },
			{ label: t('footer.visaEntry'), href: '/practical-info/visa-and-entry/' },
			{ label: t('footer.healthSafety'), href: '/practical-info/health-and-safety/' },
		],
	},
	{
		title: t('footer.project'),
		links: [
			{ label: t('footer.aboutDhaka'), href: '/overview/' },
			{ label: 'GitHub', href: 'https://github.com/Tingeworks/visitdhakaorg', external: true },
			{ label: 'Tingeworks', href: 'https://tingeworks.com', external: true },
		],
	},
].map((column) => ({
	...column,
	links: column.links.map((link) => ({ ...link, href: link.external ? link.href : localizePath(link.href, locale) })),
}));

const credit = t('footer.credit', {
	link: '<a href="https://tingeworks.com" target="_blank" rel="noopener noreferrer">Tingeworks</a>',
	interpolation: { escapeValue: false },
});
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="container">
	<div class="top">
		<div class="brand">
			<a class="name" href={localizePath('/', locale)}>Visit Dhaka</a>
			<p>{t('footer.tagline')}</p>
		</div>
		<nav class="columns" aria-label={t('footer.label')}>
			{
				columns.map((column) => (
					<div class="column">
						<h2>{column.title}</h2>
						<ul>
							{column.links.map((link) => (
								<li>
									<a
										href={link.href}
										{...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
									>
										{link.label}
									</a>
								</li>
							))}
						</ul>
					</div>
				))
			}
		</nav>
	</div>
	<div class="bottom">
		<p>&copy; {year} Visit Dhaka.</p>
		<p set:html={credit} />
	</div>
	</div>
</footer>

<style>
	.site-footer {
		/* Sits above Starlight's fixed sidebar (z-index 5) but below the navbar (10), so it slides over the sidebar. */
		position: relative;
		z-index: 6;
		border-top: 1px solid var(--sl-color-hairline);
		background: var(--sl-color-bg-sidebar);
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
	/* Full-width container, with the same side padding as the navbar so the edges line up with the header. */
	.container {
		width: 100%;
		padding: 3rem var(--sl-nav-pad-x) 2rem;
	}
	.top {
		display: grid;
		gap: 2rem;
	}
	.name {
		font-family: var(--vd-font-display);
		font-size: var(--sl-text-2xl);
		font-weight: 700;
		letter-spacing: -0.01em;
		color: var(--sl-color-white);
		text-decoration: none;
	}
	.brand p {
		max-width: 34ch;
		margin-top: 0.5rem;
		line-height: 1.5;
	}
	.columns {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 2rem 1.5rem;
	}
	h2 {
		margin: 0 0 0.75rem;
		font-size: var(--sl-text-xs);
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--sl-color-white);
	}
	ul {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	a {
		color: inherit;
		text-decoration: none;
	}
	a:hover,
	a:focus-visible {
		color: var(--sl-color-white);
		text-decoration: underline;
	}
	.bottom {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		margin-top: 2.5rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--sl-color-hairline);
		font-size: var(--sl-text-xs);
		line-height: 1.5;
	}
	.bottom p {
		margin: 0;
	}
	.bottom a {
		text-decoration: underline;
	}

	@media (min-width: 50rem) {
		.top {
			grid-template-columns: minmax(0, 1.2fr) minmax(0, 3fr);
			gap: 3rem;
		}
		.columns {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}
		.bottom {
			flex-direction: row;
			justify-content: space-between;
			gap: 2rem;
		}
	}
</style>
