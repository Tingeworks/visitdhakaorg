---
import EditLink from 'virtual:starlight/components/EditLink';
import LastUpdated from 'virtual:starlight/components/LastUpdated';
import Pagination from 'virtual:starlight/components/Pagination';

// Mirrors the sidebar groups in astro.config.mjs.
const columns = [
	{
		title: 'Explore',
		links: [
			{ label: 'Areas & Neighborhoods', href: '/areas/' },
			{ label: 'Attractions & Landmarks', href: '/attractions/' },
			{ label: 'Culture & Festivals', href: '/culture/' },
			{ label: 'Shopping', href: '/shopping/' },
			{ label: 'Day Trips', href: '/day-trips/' },
		],
	},
	{
		title: 'Eat & Stay',
		links: [
			{ label: 'Food & Dining', href: '/food/' },
			{ label: 'Where to Stay', href: '/where-to-stay/' },
		],
	},
	{
		title: 'Plan Your Trip',
		links: [
			{ label: 'Getting Around', href: '/getting-around/' },
			{ label: 'Practical Info', href: '/practical-info/' },
			{ label: 'Visa & Entry', href: '/practical-info/visa-and-entry/' },
			{ label: 'Health & Safety', href: '/practical-info/health-and-safety/' },
		],
	},
	{
		title: 'Project',
		links: [
			{ label: 'About Dhaka', href: '/overview/' },
			{ label: 'GitHub', href: 'https://github.com/Tingeworks/visitdhakaorg', external: true },
			{ label: 'Tingeworks', href: 'https://tingeworks.com', external: true },
		],
	},
];

const year = new Date().getFullYear();
---

<footer class="sl-flex">
	<div class="meta sl-flex">
		<EditLink />
		<LastUpdated />
	</div>
	<Pagination />

	<div class="site-footer">
		<div class="top">
			<div class="brand">
				<a class="name" href="/">Visit Dhaka</a>
				<p>
					A community guide to Dhaka, the capital of Bangladesh: where to go, what to eat, where to stay and how to get
					around.
				</p>
			</div>
			<nav class="columns" aria-label="Footer">
				{
					columns.map((column) => (
						<div class="column">
							<h2>{column.title}</h2>
							<ul>
								{column.links.map((link) => (
									<li>
										<a
											href={link.href}
											{...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
										>
											{link.label}
										</a>
									</li>
								))}
							</ul>
						</div>
					))
				}
			</nav>
		</div>
		<div class="bottom">
			<p>
				&copy; {year} Visit Dhaka. Written by the community, so please check hours, fees and visa rules with official
				sources before you travel.
			</p>
			<p>
				Built by <a href="https://tingeworks.com" target="_blank" rel="noopener noreferrer">Tingeworks</a>, a design and
				engineering studio in Dhaka.
			</p>
		</div>
	</div>
</footer>

<style>
	@layer starlight.core {
		footer {
			flex-direction: column;
			gap: 1.5rem;
		}
		.meta {
			gap: 0.75rem 3rem;
			justify-content: space-between;
			flex-wrap: wrap;
			margin-top: 3rem;
			font-size: var(--sl-text-sm);
			color: var(--sl-color-gray-3);
		}
		.meta > :global(p:only-child) {
			margin-inline-start: auto;
		}
	}

	@layer starlight.components {
		.site-footer {
			margin-top: 1.5rem;
			padding-top: 2.5rem;
			border-top: 1px solid var(--sl-color-hairline);
			font-size: var(--sl-text-sm);
			color: var(--sl-color-gray-3);
		}
		.top {
			display: grid;
			gap: 2rem;
		}
		.name {
			font-size: var(--sl-text-lg);
			font-weight: 600;
			color: var(--sl-color-white);
			text-decoration: none;
		}
		.brand p {
			max-width: 34ch;
			margin-top: 0.5rem;
			line-height: 1.5;
		}
		.columns {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 2rem 1.5rem;
		}
		h2 {
			margin-bottom: 0.75rem;
			font-size: var(--sl-text-xs);
			font-weight: 600;
			letter-spacing: 0.06em;
			text-transform: uppercase;
			color: var(--sl-color-white);
		}
		ul {
			display: flex;
			flex-direction: column;
			gap: 0.5rem;
			padding: 0;
			list-style: none;
		}
		a {
			color: inherit;
			text-decoration: none;
		}
		a:hover,
		a:focus-visible {
			color: var(--sl-color-white);
			text-decoration: underline;
		}
		.bottom {
			display: flex;
			flex-direction: column;
			gap: 0.5rem;
			margin-top: 2.5rem;
			padding-top: 1.5rem;
			border-top: 1px solid var(--sl-color-hairline);
			font-size: var(--sl-text-xs);
			line-height: 1.5;
		}
		.bottom a {
			text-decoration: underline;
		}

		@media (min-width: 50rem) {
			.top {
				grid-template-columns: minmax(0, 1.2fr) minmax(0, 3fr);
				gap: 3rem;
			}
			.columns {
				grid-template-columns: repeat(4, minmax(0, 1fr));
			}
		}
	}
</style>
