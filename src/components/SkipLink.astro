---
// Starlight's skip link is the first element in <body>, so the Google Tag Manager noscript fallback goes here, right after
// the opening tag as GTM asks. The GTM script itself is in the `head` option in astro.config.mjs.
import Default from '@astrojs/starlight/components/SkipLink.astro';
---

<!-- Google Tag Manager (noscript) -->
<noscript
	><iframe
		src="https://www.googletagmanager.com/ns.html?id=GTM-57LQWQ8W"
		height="0"
		width="0"
		style="display:none;visibility:hidden"></iframe
	></noscript
>
<!-- End Google Tag Manager (noscript) -->
<Default {...Astro.props} />
