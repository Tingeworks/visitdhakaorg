---
import { getCollection } from 'astro:content';
import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';

// Top-level menu. Mirrors the sidebar groups in astro.config.mjs. The pages inside each dropdown are read from the
// content collection, so a new page in one of these folders shows up here without touching this file.
// Items without `groups` are plain links.
type Group = { label: string; dir: string };
type Item = { label: string; icon: string; blurb?: string; href?: string; groups?: Group[] };

const menu: Item[] = [
	{
		label: 'Explore',
		icon: 'compass',
		blurb: 'Neighborhoods, landmarks, festivals, markets and day trips.',
		groups: [
			{ label: 'Areas & Neighborhoods', dir: 'areas' },
			{ label: 'Attractions', dir: 'attractions' },
			{ label: 'Culture & Festivals', dir: 'culture' },
			{ label: 'Shopping', dir: 'shopping' },
			{ label: 'Day Trips', dir: 'day-trips' },
		],
	},
	{ label: 'Eat', icon: 'utensils', groups: [{ label: 'Food & Dining', dir: 'food' }] },
	{ label: 'Stay', icon: 'bed', href: '/where-to-stay/' },
	{ label: 'Get Around', icon: 'map', groups: [{ label: 'Getting Around', dir: 'getting-around' }] },
	{ label: 'Plan Your Trip', icon: 'info', groups: [{ label: 'Practical Info', dir: 'practical-info' }] },
];

const docs = await getCollection('docs');
const slugOf = (id: string) => id.replace(/\.(md|mdx)$/, '').replace(/\/?index$/, '');

/** The overview page of a folder plus its child pages, sorted like the sidebar (order, then title). */
function pagesIn(dir: string) {
	const overview = docs.find((entry) => slugOf(entry.id) === dir);
	const children = docs
		.filter((entry) => slugOf(entry.id).startsWith(`${dir}/`))
		.sort(
			(a, b) =>
				(a.data.sidebar?.order ?? Infinity) - (b.data.sidebar?.order ?? Infinity) ||
				a.data.title.localeCompare(b.data.title),
		)
		.map((entry) => ({ title: entry.data.title, description: entry.data.description, href: `/${slugOf(entry.id)}/` }));
	return { href: `/${dir}/`, description: overview?.data.description, children };
}

const items = menu.map((item) => ({
	...item,
	groups: item.groups?.map((group) => ({ ...group, ...pagesIn(group.dir) })),
}));

const pathname = Astro.url.pathname;
const isActive = (item: (typeof items)[number]) =>
	item.href
		? pathname.startsWith(item.href)
		: item.groups?.some((group) => pathname.startsWith(`/${group.dir}/`)) ?? false;
---

<div class="header">
	<div class="title-wrapper sl-flex">
		<SiteTitle />
	</div>

	<vd-nav class="print:hidden">
		<nav aria-label="Main">
			<ul>
				{
					items.map((item) => {
						const groups = item.groups ?? [];
						const mega = groups.length > 1;
						const active = isActive(item);
						return (
							<li class="item" data-has-panel={groups.length ? '' : undefined}>
								{groups.length ? (
									<>
										<button
											type="button"
											class="trigger"
											aria-expanded="false"
											aria-current={active ? 'true' : undefined}
											aria-controls={`vd-panel-${item.label}`}
										>
											{item.label}
											<svg class="caret" viewBox="0 0 12 12" width="12" height="12" aria-hidden="true">
												<path d="m2.5 4.5 3.5 3.5 3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
											</svg>
										</button>
										<div class:list={['panel', mega ? 'panel-mega' : 'panel-list']} id={`vd-panel-${item.label}`}>
											<div class="panel-inner">
												{mega ? (
													<>
														<div class="mega-grid">
															{groups.map((group) => (
																<div class="mega-group">
																	<a class="mega-heading" href={group.href}>
																		{group.label}
																		<span aria-hidden="true">→</span>
																	</a>
																	<ul>
																		{group.children.map((page) => (
																			<li>
																				<a href={page.href} aria-current={pathname === page.href ? 'page' : undefined}>
																					{page.title}
																				</a>
																			</li>
																		))}
																	</ul>
																</div>
															))}
														</div>
														<a class="mega-footer" href="/overview/">
															<span>
																<strong>New to Dhaka?</strong> Start with the city overview.
															</span>
															<span aria-hidden="true">→</span>
														</a>
													</>
												) : (
													<>
														<div class="intro">
															<span class="icon-tile" aria-hidden="true">
																<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
																	{item.icon === 'utensils' && (
																		<>
																			<path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2" />
																			<path d="M7 2v20" />
																			<path d="M21 15V2a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7" />
																		</>
																	)}
																	{item.icon === 'map' && (
																		<>
																			<polygon points="3 6 9 3 15 6 21 3 21 18 15 21 9 18 3 21" />
																			<line x1="9" x2="9" y1="3" y2="18" />
																			<line x1="15" x2="15" y1="6" y2="21" />
																		</>
																	)}
																	{item.icon === 'info' && (
																		<>
																			<circle cx="12" cy="12" r="10" />
																			<path d="M12 16v-4" />
																			<path d="M12 8h.01" />
																		</>
																	)}
																</svg>
															</span>
															<p class="intro-title">{groups[0].label}</p>
															<p class="intro-text">{groups[0].description}</p>
															<a class="intro-link" href={groups[0].href}>
																Browse all
																<span aria-hidden="true">→</span>
															</a>
														</div>
														<ul class="entries">
															{groups[0].children.map((page) => (
																<li>
																	<a class="entry" href={page.href} aria-current={pathname === page.href ? 'page' : undefined}>
																		<span class="entry-title">{page.title}</span>
																		{page.description && <span class="entry-desc">{page.description}</span>}
																	</a>
																</li>
															))}
														</ul>
													</>
												)}
											</div>
										</div>
									</>
								) : (
									<a class="trigger" href={item.href} aria-current={active ? 'page' : undefined}>
										{item.label}
									</a>
								)}
							</li>
						);
					})
				}
			</ul>
		</nav>
	</vd-nav>

	<div class="actions sl-flex print:hidden">
		<Search />
		<div class="sl-hidden md:sl-flex right-group">
			<ThemeSelect />
			<LanguageSelect />
		</div>
	</div>
</div>

<script>
	// Dropdowns open on hover for mouse users and on click or Enter for everyone else. Escape and outside clicks close.
	class VdNav extends HTMLElement {
		connectedCallback() {
			const items = [...this.querySelectorAll<HTMLElement>('.item[data-has-panel]')];
			const hoverable = matchMedia('(hover: hover)');
			let closeTimer: number | undefined;

			// Panels default to the trigger's left edge. If that would push them off-screen, shift them back inside.
			const fitPanel = (item: HTMLElement) => {
				const panel = item.querySelector<HTMLElement>('.panel');
				if (!panel) return;
				const margin = 16;
				panel.style.left = '0px';
				const { left } = item.getBoundingClientRect();
				const overflow = left + panel.offsetWidth - (document.documentElement.clientWidth - margin);
				const shift = Math.max(-overflow, margin - left);
				panel.style.left = `${Math.min(0, Math.max(shift, margin - left))}px`;
			};

			const setOpen = (item: HTMLElement, open: boolean) => {
				if (open) fitPanel(item);
				item.toggleAttribute('data-open', open);
				item.querySelector('button')?.setAttribute('aria-expanded', String(open));
				if (!open) item.removeAttribute('data-hovered');
			};
			const closeAll = (except?: HTMLElement) => items.forEach((item) => item !== except && setOpen(item, false));

			for (const item of items) {
				const button = item.querySelector('button')!;
				button.addEventListener('click', () => {
					// A click right after a hover-open would toggle the menu shut again, so keep it open instead.
					if (item.hasAttribute('data-hovered')) return item.removeAttribute('data-hovered');
					const open = !item.hasAttribute('data-open');
					closeAll(item);
					setOpen(item, open);
				});
				item.addEventListener('mouseenter', () => {
					if (!hoverable.matches) return;
					clearTimeout(closeTimer);
					closeAll(item);
					if (!item.hasAttribute('data-open')) item.setAttribute('data-hovered', '');
					setOpen(item, true);
				});
				item.addEventListener('mouseleave', () => {
					if (!hoverable.matches) return;
					closeTimer = window.setTimeout(() => setOpen(item, false), 150);
				});
				item.addEventListener('focusout', (event) => {
					if (!item.contains(event.relatedTarget as Node | null)) setOpen(item, false);
				});
			}

			document.addEventListener('click', (event) => {
				if (!this.contains(event.target as Node)) closeAll();
			});
			this.addEventListener('keydown', (event) => {
				if (event.key !== 'Escape') return;
				const open = items.find((item) => item.hasAttribute('data-open'));
				closeAll();
				open?.querySelector('button')?.focus();
			});
		}
	}
	if (!customElements.get('vd-nav')) customElements.define('vd-nav', VdNav);
</script>

<style>
	@layer starlight.core {
		.header {
			display: flex;
			gap: var(--sl-nav-gap);
			justify-content: space-between;
			align-items: center;
			height: 100%;
		}
		.title-wrapper {
			/* Prevent long titles overflowing and covering the search and menu buttons on narrow viewports. */
			overflow: clip;
			/* Avoid clipping focus ring around link inside title wrapper. */
			padding: 0.25rem;
			margin: -0.25rem;
			min-width: 0;
		}
		.actions,
		.right-group {
			gap: 1rem;
			align-items: center;
		}

		@media (min-width: 50rem) {
			:global(:root[data-has-sidebar]) {
				--__sidebar-pad: calc(2 * var(--sl-nav-pad-x));
			}
			:global(:root:not([data-has-toc])) {
				--__toc-width: 0rem;
			}
			.header {
				--__sidebar-width: max(0rem, var(--sl-content-inline-start, 0rem) - var(--sl-nav-pad-x));
				--__main-column-fr: calc(
					(
							100% + var(--__sidebar-pad, 0rem) - var(--__toc-width, var(--sl-sidebar-width)) -
								(2 * var(--__toc-width, var(--sl-nav-pad-x))) - var(--sl-content-inline-start, 0rem) -
								var(--sl-content-width)
						) / 2
				);
				display: grid;
				/* Site title (lines the nav up with the content column), nav (free space), search and theme. */
				grid-template-columns:
					minmax(calc(var(--__sidebar-width) + max(0rem, var(--__main-column-fr) - var(--sl-nav-gap))), auto)
					1fr
					auto;
				align-content: center;
			}
			/* Search sits at the right edge, next to the theme picker. */
			.actions :global(button[data-open-modal]) {
				width: 13rem;
			}
		}
	}

	/* ---------- Primary nav ---------- */
	vd-nav {
		display: none;
	}
	@media (min-width: 64rem) {
		vd-nav {
			display: block;
			align-self: stretch;
			min-width: 0;
		}
		nav,
		nav > ul {
			height: 100%;
		}
	}
	nav > ul {
		display: flex;
		align-items: center;
		gap: 0.125rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.item {
		position: relative;
		display: flex;
		align-items: center;
		height: 100%;
	}

	.trigger {
		position: relative;
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		padding: 0.45rem 0.8rem;
		border: 0;
		border-radius: var(--vd-radius-md, 0.625rem);
		background: transparent;
		font: inherit;
		font-size: var(--sl-text-sm);
		font-weight: 550;
		color: var(--sl-color-gray-2);
		text-decoration: none;
		cursor: pointer;
		transition:
			background-color var(--vd-duration, 160ms) var(--vd-ease, ease),
			color var(--vd-duration, 160ms) var(--vd-ease, ease);
	}
	.trigger:hover,
	.item[data-open] > .trigger {
		background: var(--sl-color-accent-low);
		color: var(--sl-color-white);
	}
	.trigger[aria-current] {
		color: var(--sl-color-text-accent);
	}
	/* Small underline marks the section you are in. */
	.trigger[aria-current]::after {
		content: '';
		position: absolute;
		inset-inline: 0.8rem;
		bottom: 0.1rem;
		height: 2px;
		border-radius: 2px;
		background: currentColor;
	}
	.caret {
		opacity: 0.7;
		transition: transform var(--vd-duration, 160ms) var(--vd-ease, ease);
	}
	.item[data-open] .caret {
		transform: rotate(180deg);
	}

	/* ---------- Dropdown panels ---------- */
	.panel {
		position: absolute;
		top: 100%;
		left: 0;
		z-index: 30;
		/* Invisible bridge so the pointer can travel from the trigger to the panel without closing it. */
		padding-top: 0.75rem;
		opacity: 0;
		visibility: hidden;
		transform: translateY(-6px);
		transition:
			opacity var(--vd-duration, 160ms) var(--vd-ease, ease),
			transform var(--vd-duration, 160ms) var(--vd-ease, ease),
			visibility 0s linear var(--vd-duration, 160ms);
	}
	.item[data-open] > .panel {
		opacity: 1;
		visibility: visible;
		transform: none;
		transition-delay: 0s;
	}
	.panel-inner {
		overflow: hidden;
		border: 1px solid var(--sl-color-hairline-light);
		border-radius: var(--vd-radius-lg, 1rem);
		background: var(--vd-surface, var(--sl-color-bg));
		box-shadow: var(--sl-shadow-lg);
		font-size: var(--sl-text-sm);
	}
	.panel-mega {
		width: min(47rem, calc(100vw - 2rem));
	}
	.panel-list {
		width: min(38rem, calc(100vw - 2rem));
	}
	.panel-inner ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.panel-inner a {
		text-decoration: none;
	}

	/* Mega menu (Explore): one column per section. */
	.mega-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1.5rem 1.25rem;
		padding: 1.5rem;
	}
	.mega-heading {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		margin-bottom: 0.5rem;
		padding-bottom: 0.5rem;
		border-bottom: 1px solid var(--sl-color-hairline);
		font-size: var(--sl-text-xs);
		font-weight: 650;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--sl-color-text-accent);
	}
	.mega-heading span {
		transition: transform var(--vd-duration, 160ms) var(--vd-ease, ease);
	}
	.mega-heading:hover span {
		transform: translateX(3px);
	}
	.mega-group li a {
		display: block;
		margin-inline: -0.5rem;
		padding: 0.3rem 0.5rem;
		border-radius: var(--vd-radius-sm, 0.375rem);
		color: var(--sl-color-gray-2);
	}
	.mega-group li a:hover,
	.mega-group li a[aria-current] {
		background: var(--sl-color-accent-low);
		color: var(--sl-color-white);
	}
	.mega-footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.9rem 1.5rem;
		border-top: 1px solid var(--sl-color-hairline);
		background: var(--sl-color-accent-low);
		color: var(--sl-color-gray-1);
	}
	.mega-footer strong {
		color: var(--sl-color-white);
	}
	.mega-footer:hover {
		color: var(--sl-color-white);
	}

	/* List menu (Eat, Get Around, Plan Your Trip): intro on the left, pages with descriptions on the right. */
	.panel-list .panel-inner {
		display: grid;
		grid-template-columns: 13rem minmax(0, 1fr);
	}
	.intro {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		padding: 1.5rem;
		background: var(--sl-color-accent-low);
	}
	.icon-tile {
		display: grid;
		place-items: center;
		width: 2.5rem;
		height: 2.5rem;
		margin-bottom: 0.25rem;
		border-radius: var(--vd-radius-md, 0.625rem);
		background: var(--vd-surface, var(--sl-color-bg));
		color: var(--sl-color-text-accent);
		box-shadow: var(--sl-shadow-sm);
	}
	.intro p {
		margin: 0;
	}
	.intro-title {
		font-family: var(--vd-font-display, inherit);
		font-size: var(--sl-text-xl);
		font-weight: 700;
		line-height: 1.2;
		color: var(--sl-color-white);
	}
	.intro-text {
		font-size: var(--sl-text-xs);
		line-height: 1.5;
		color: var(--sl-color-gray-2);
		display: -webkit-box;
		-webkit-line-clamp: 5;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.intro-link {
		margin-top: auto;
		padding-top: 0.5rem;
		font-weight: 600;
		color: var(--sl-color-text-accent);
	}
	.intro-link span {
		display: inline-block;
		transition: transform var(--vd-duration, 160ms) var(--vd-ease, ease);
	}
	.intro-link:hover span {
		transform: translateX(3px);
	}
	.entries {
		display: flex;
		flex-direction: column;
		gap: 0.125rem;
		padding: 0.75rem !important;
	}
	.entry {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		padding: 0.55rem 0.75rem;
		border-radius: var(--vd-radius-md, 0.625rem);
		transition: background-color var(--vd-duration, 160ms) var(--vd-ease, ease);
	}
	.entry:hover,
	.entry[aria-current] {
		background: var(--sl-color-accent-low);
	}
	.entry-title {
		font-weight: 600;
		color: var(--sl-color-white);
	}
	.entry-desc {
		font-size: var(--sl-text-xs);
		line-height: 1.45;
		color: var(--sl-color-gray-3);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
</style>
