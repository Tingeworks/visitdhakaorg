---
// One homepage segment: eyebrow, heading, intro and "see all" links, with the section's cards in the slot.
// `not-content` opts out of Starlight's Markdown styles, which the homepage MDX would otherwise apply.
// An optional `image` sits to the left of the heading, such as the rickshaw beside Dhaka Now. It's decorative, so it has
// empty alt text, and Astro resizes it to WebP at build time.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
	id: string;
	title: string;
	eyebrow?: string;
	intro?: string;
	links?: { label: string; href: string; external?: boolean }[];
	image?: ImageMetadata;
}

const { id, title, eyebrow, intro, links = [], image } = Astro.props;
---

<section class:list={['home-section', 'not-content', { 'has-art': image }]} aria-labelledby={`${id}-title`}>
	<div class="head">
		<div class="lead">
			{image && <Image src={image} alt="" class="art" widths={[128, 256, 384, 512]} sizes="(min-width: 50em) 256px, 128px" />}
			<div class="copy">
				{eyebrow && <p class="eyebrow">{eyebrow}</p>}
				<h2 id={`${id}-title`}>{title}</h2>
				{intro && <p class="intro">{intro}</p>}
			</div>
		</div>
		{
			links.length > 0 && (
				<ul class="links">
					{links.map((link) => (
						<li>
							<a
								href={link.href}
								{...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
							>
								{link.label}
								<span aria-hidden="true">{link.external ? '↗' : '→'}</span>
							</a>
						</li>
					))}
				</ul>
			)
		}
	</div>
	<slot />
</section>

<style>
	/* Sections are separated by space alone, no rule between them. */
	.home-section {
		margin-top: 4.5rem;
	}
	.home-section:first-of-type {
		margin-top: 2.5rem;
	}
	@media (min-width: 50em) {
		.home-section {
			margin-top: 6rem;
		}
		.home-section:first-of-type {
			margin-top: 3rem;
		}
	}
	.head {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1.25rem 2rem;
		margin-bottom: 2rem;
	}
	.lead {
		display: flex;
		align-items: flex-end;
		gap: 1rem;
	}
	.art {
		flex: none;
		width: 8rem;
		height: auto;
	}
	@media (min-width: 50em) {
		.lead {
			gap: 1.75rem;
		}
		.art {
			width: 16rem;
		}
	}
	.copy {
		max-width: 42rem;
	}
	/* Beside an image, the heading is scaled up to hold its own against it. The sizes come from the site's type scale,
	   so the reader's text-size setting still applies. */
	.has-art h2 {
		font-size: calc(var(--sl-text-h2) * 1.35);
	}
	@media (min-width: 50em) {
		.has-art .eyebrow {
			font-size: var(--sl-text-sm);
		}
		.has-art h2 {
			font-size: calc(var(--sl-text-h1) * 1.4);
		}
		.has-art .intro {
			max-width: 34rem;
			font-size: var(--sl-text-xl);
		}
	}
	/* Eyebrow: a short Krishnachura rule leading into the label, in the same type as the cards' eyebrows. */
	.eyebrow {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin: 0 0 0.875rem;
		font-size: var(--sl-text-xs);
		font-weight: 600;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--sl-color-text-accent);
	}
	.eyebrow::before {
		content: '';
		flex: none;
		width: 1.75rem;
		height: 2px;
		border-radius: 1px;
		background: currentColor;
	}
	h2 {
		margin: 0;
		font-family: var(--vd-font-display);
		font-size: calc(var(--sl-text-h2) * 1.15);
		font-weight: 650;
		line-height: 1.1;
		letter-spacing: -0.025em;
		color: var(--sl-color-white);
		text-wrap: balance;
	}
	.intro {
		margin: 0.875rem 0 0;
		max-width: 36rem;
		font-size: var(--sl-text-base);
		line-height: 1.6;
		color: var(--sl-color-gray-2);
		text-wrap: pretty;
	}
	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
		font-size: var(--sl-text-sm);
		font-weight: 600;
	}
	/* Quiet outlined buttons, matching the cards' border and hover treatment. */
	.links a {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.5rem 0.9rem;
		border: 1px solid var(--sl-color-hairline-light);
		border-radius: var(--vd-radius-md);
		color: var(--sl-color-text-accent);
		text-decoration: none;
		white-space: nowrap;
		transition: border-color var(--vd-duration) var(--vd-ease), background-color var(--vd-duration) var(--vd-ease);
	}
	.links a span {
		transition: transform var(--vd-duration) var(--vd-ease);
	}
	.links a:hover,
	.links a:focus-visible {
		border-color: var(--sl-color-accent);
		background: var(--vd-hover);
	}
	.links a:hover span,
	.links a:focus-visible span {
		transform: translateX(2px);
	}
	@media (prefers-reduced-motion: reduce) {
		.links a,
		.links a span {
			transition: none;
		}
		.links a:hover span,
		.links a:focus-visible span {
			transform: none;
		}
	}
</style>
