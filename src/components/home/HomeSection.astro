---
// One homepage segment: eyebrow, heading, intro and "see all" links, with the section's cards in the slot.
// `not-content` opts out of Starlight's Markdown styles, which the homepage MDX would otherwise apply.
interface Props {
	id: string;
	title: string;
	eyebrow?: string;
	intro?: string;
	links?: { label: string; href: string; external?: boolean }[];
}

const { id, title, eyebrow, intro, links = [] } = Astro.props;
---

<section class="home-section not-content" aria-labelledby={`${id}-title`}>
	<div class="head">
		<div class="copy">
			{eyebrow && <p class="eyebrow">{eyebrow}</p>}
			<h2 id={`${id}-title`}>{title}</h2>
			{intro && <p class="intro">{intro}</p>}
		</div>
		{
			links.length > 0 && (
				<ul class="links">
					{links.map((link) => (
						<li>
							<a
								href={link.href}
								{...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
							>
								{link.label}
								<span aria-hidden="true">{link.external ? '↗' : '→'}</span>
							</a>
						</li>
					))}
				</ul>
			)
		}
	</div>
	<slot />
</section>

<style>
	.home-section {
		margin-top: 3.5rem;
		padding-top: 2.5rem;
		border-top: 1px solid var(--sl-color-hairline);
	}
	.head {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1rem 2rem;
		margin-bottom: 1.5rem;
	}
	.copy {
		max-width: 40rem;
	}
	.eyebrow {
		margin: 0 0 0.5rem;
		font-size: var(--sl-text-xs);
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--sl-color-text-accent);
	}
	h2 {
		margin: 0;
		font-family: var(--vd-font-display);
		font-size: var(--sl-text-h2);
		font-weight: 650;
		line-height: var(--sl-line-height-headings);
		letter-spacing: -0.02em;
		color: var(--sl-color-white);
	}
	.intro {
		margin: 0.75rem 0 0;
		color: var(--sl-color-gray-2);
		line-height: 1.6;
		text-wrap: pretty;
	}
	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
		font-size: var(--sl-text-sm);
		font-weight: 600;
	}
	.links a {
		display: inline-flex;
		gap: 0.35rem;
		color: var(--sl-color-text-accent);
		text-decoration: none;
	}
	.links a:hover,
	.links a:focus-visible {
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}
</style>
