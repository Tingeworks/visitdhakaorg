---
// Cards for the pages in one content pillar, using each page's own title and description, so the homepage stays in
// step with what editors write in the CMS. New pages in the folder appear after the ones named in `order`.
import { localeOf, localizedPages } from '../../lib/i18n';
import CardGrid from './CardGrid.astro';
import HomeCard from './HomeCard.astro';

interface Props {
	/** Pillar folder in src/content/docs, such as `areas`. */
	dir: string;
	/** Page slugs within the folder, in the order they should appear. */
	order?: string[];
	limit?: number;
	/** Frontmatter field shown above the title. `number` shows the card's position instead (01, 02, ...). */
	eyebrow?: 'category' | 'area' | 'bestTime' | 'number';
	columns?: 2 | 3 | 4;
}

const { dir, order = [], limit = Infinity, eyebrow, columns } = Astro.props;

const rank = (slug: string) => {
	const index = order.indexOf(slug.slice(dir.length + 1));
	return index === -1 ? Infinity : index;
};

// In the page's language, falling back to English for pages that haven't been translated.
const pages = (await localizedPages(localeOf(Astro.url)))
	.filter((page) => page.slug.startsWith(`${dir}/`))
	.sort((a, b) => rank(a.slug) - rank(b.slug) || a.data.title.localeCompare(b.data.title))
	.slice(0, limit);
---

<CardGrid columns={columns}>
	{
		pages.map(({ href, data }, index) => (
			<HomeCard
				href={href}
				title={data.title}
				description={data.description}
				eyebrow={eyebrow === 'number' ? String(index + 1).padStart(2, '0') : eyebrow ? data[eyebrow] : undefined}
			/>
		))
	}
</CardGrid>
