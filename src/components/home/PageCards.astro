---
// Cards or photo tiles for the pages in one content pillar, using each page's own title, description and cover photo,
// so the homepage stays in step with what editors write in the CMS. New pages in the folder appear after the ones
// named in `order`. `variant` picks the layout:
//   cards   text cards (HomeCard) in a CardGrid, the default
//   mosaic  photo tiles with the first page as a large lead tile, a sideways rail on phones
//   rail    a row of portrait photo tiles, a sideways rail on phones
//   plates  round photos beside the text, for dishes
//   panels  two wide photo tiles
//   steps   numbered checklist cards with an icon (from `icons`) and the page's description, with no photos
// In the photo layouts, a page without a cover photo falls back to a text card.
import { Icon } from '@astrojs/starlight/components';
import type { StarlightIcon } from '@astrojs/starlight/types';
import { localeOf, localizedPages, type LocalizedPage } from '../../lib/i18n';
import CardGrid from './CardGrid.astro';
import HomeCard from './HomeCard.astro';
import PhotoTile from './PhotoTile.astro';

interface Props {
	/** Pillar folder in src/content/docs, such as `areas`. */
	dir: string;
	/** Page slugs within the folder, in the order they should appear. */
	order?: string[];
	limit?: number;
	/** Frontmatter field shown above the title. `number` shows the card's position instead (01, 02, ...), `tags` the
	 * page's first two tags. */
	eyebrow?: 'category' | 'area' | 'bestTime' | 'number' | 'tags';
	columns?: 2 | 3 | 4;
	variant?: 'cards' | 'mosaic' | 'rail' | 'plates' | 'panels' | 'steps';
	/** Steps only: a Starlight icon for each page slug. Pages without one show the default icon. */
	icons?: Record<string, StarlightIcon>;
}

const { dir, order = [], limit = Infinity, eyebrow, columns, variant = 'cards', icons = {} } = Astro.props;
const locale = localeOf(Astro.url);

const rank = (slug: string) => {
	const index = order.indexOf(slug.slice(dir.length + 1));
	return index === -1 ? Infinity : index;
};

// In the page's language, falling back to English for pages that haven't been translated.
const pages = (await localizedPages(locale))
	.filter((page) => page.slug.startsWith(`${dir}/`))
	.sort((a, b) => rank(a.slug) - rank(b.slug) || a.data.title.localeCompare(b.data.title))
	.slice(0, limit);

// A translated page without a photo of its own uses the English page's, so a photo added to the English page shows in
// both languages.
const english = locale ? new Map((await localizedPages(undefined)).map((page) => [page.slug, page.data])) : undefined;
const photoOf = ({ slug, data }: LocalizedPage) => {
	const source = data.image ? data : english?.get(slug);
	return source?.image ? { image: source.image, imageAlt: source.imageAlt, imageCredit: source.imageCredit } : undefined;
};
const eyebrowOf = (data: LocalizedPage['data'], index: number) => {
	if (eyebrow === 'number') return String(index + 1).padStart(2, '0');
	if (eyebrow === 'tags') return data.tags.slice(0, 2).join(' · ') || undefined;
	return eyebrow ? data[eyebrow] : undefined;
};

const items = pages.map((page, index) => ({ ...page, photo: photoOf(page), eyebrow: eyebrowOf(page.data, index) }));
const photoLayout = variant === 'mosaic' || variant === 'rail' || variant === 'panels';
---

{
	variant === 'cards' && (
		<CardGrid columns={columns}>
			{items.map(({ href, data, eyebrow }) => (
				<HomeCard href={href} title={data.title} description={data.description} eyebrow={eyebrow} />
			))}
		</CardGrid>
	)
}

{
	photoLayout && (
		<div class:list={['tiles', variant]}>
			{items.map(({ href, data, photo, eyebrow }, index) =>
				photo ? (
					<PhotoTile
						href={href}
						title={data.title}
						description={data.description}
						eyebrow={eyebrow}
						size={variant === 'panels' || (variant === 'mosaic' && index === 0) ? 'lg' : 'md'}
						{...photo}
					/>
				) : (
					<HomeCard href={href} title={data.title} description={data.description} eyebrow={eyebrow} />
				)
			)}
		</div>
	)
}

{
	variant === 'plates' && (
		<div class="plates">
			{items.map(({ href, data, photo, eyebrow }) => (
				<a class="plate vd-reveal" href={href}>
					{photo ? (
						<img
							class="plate-photo"
							src={photo.image}
							alt={photo.imageAlt ?? ''}
							width="1000"
							height="1000"
							loading="lazy"
							decoding="async"
						/>
					) : (
						<span class="plate-photo" />
					)}
					<div class="plate-text">
						{eyebrow && <span class="eyebrow">{eyebrow}</span>}
						<h3>{data.title}</h3>
						{data.description && <p>{data.description}</p>}
						{photo?.imageCredit && <small class="credit">{photo.imageCredit}</small>}
					</div>
				</a>
			))}
		</div>
	)
}

{
	variant === 'steps' && (
		<ol class="steps">
			{items.map(({ slug, href, data }, index) => (
				<li>
					<a class="step vd-reveal" href={href}>
						<span class="step-top" aria-hidden="true">
							<span class="badge">
								<Icon name={icons[slug.slice(dir.length + 1)] ?? 'information'} size="1.375rem" />
							</span>
							<span class="number">{String(index + 1).padStart(2, '0')}</span>
						</span>
						<h3>{data.title}</h3>
						{data.description && <p>{data.description}</p>}
						<span class="arrow" aria-hidden="true">
							<Icon name="right-arrow" size="1.125rem" />
						</span>
					</a>
				</li>
			))}
		</ol>
	)
}

<style>
	/* ---------- Photo layouts: mosaic, rail and panels ---------- */
	.tiles {
		display: grid;
		gap: 1rem;
	}
	/* On phones the photo layouts become a rail that scrolls sideways, edge to edge, with the next tile peeking in. */
	@media (max-width: 35.99rem) {
		.tiles {
			display: flex;
			gap: 0.75rem;
			margin-inline: calc(-1 * var(--sl-content-pad-x));
			padding-inline: var(--sl-content-pad-x);
			padding-bottom: 0.25rem;
			overflow-x: auto;
			scroll-snap-type: x mandatory;
			scroll-padding-inline: var(--sl-content-pad-x);
			scrollbar-width: none;
			--tile-aspect: 4 / 5;
		}
		.tiles::-webkit-scrollbar {
			display: none;
		}
		.tiles > :global(*) {
			flex: 0 0 min(76%, 18rem);
			scroll-snap-align: start;
		}
	}
	/* Mosaic: at two columns the lead tile runs across the top; from 64rem it takes two columns and two rows, with the
	   other five around it. */
	@media (min-width: 36rem) {
		.mosaic {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
		.mosaic > :global(:first-child) {
			grid-column: 1 / -1;
			--tile-aspect: 2 / 1;
		}
		.rail {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			--tile-aspect: 4 / 5;
		}
		.panels {
			--tile-aspect: 16 / 9;
		}
	}
	@media (min-width: 50rem) {
		.rail {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}
		.panels {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			--tile-aspect: 16 / 10;
		}
	}
	@media (min-width: 64rem) {
		.mosaic {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
		.mosaic > :global(:first-child) {
			grid-column: span 2;
			grid-row: span 2;
			--tile-aspect: auto;
		}
	}

	/* ---------- Plates: a round photo beside the text, like a menu ---------- */
	.plates {
		display: grid;
		gap: 2rem 2.5rem;
	}
	@media (min-width: 50rem) {
		.plates {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	.plate {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		align-items: center;
		gap: 1.25rem;
		color: inherit;
		text-decoration: none;
	}
	@media (min-width: 36rem) {
		.plate {
			gap: 1.75rem;
		}
	}
	.plate-photo {
		display: block;
		width: clamp(6.5rem, 24vw, 13rem);
		/* The image's height attribute would otherwise win over the aspect ratio. */
		height: auto;
		aspect-ratio: 1;
		border-radius: 50%;
		object-fit: cover;
		background: var(--sl-color-gray-6);
		/* A rim like a plate's: a gap in the page colour, then a hairline. The hairline turns Krishnachura on hover. */
		box-shadow: 0 0 0 5px var(--vd-surface), 0 0 0 6px var(--sl-color-hairline-light), var(--sl-shadow-md);
		transition: transform 700ms var(--vd-ease), box-shadow var(--vd-duration) var(--vd-ease);
	}
	.plate:hover .plate-photo,
	.plate:focus-visible .plate-photo {
		transform: rotate(-8deg) scale(1.04);
		box-shadow: 0 0 0 5px var(--vd-surface), 0 0 0 6px var(--sl-color-accent), var(--sl-shadow-lg);
	}
	.plate-text {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}
	.eyebrow {
		font-size: var(--sl-text-xs);
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--sl-color-text-accent);
	}
	.plate h3 {
		margin: 0;
		font-family: var(--vd-font-display);
		font-size: var(--sl-text-2xl);
		font-weight: 700;
		line-height: 1.15;
		letter-spacing: -0.02em;
		color: var(--sl-color-white);
	}
	.plate p {
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		overflow: hidden;
		margin: 0;
		font-size: var(--sl-text-sm);
		line-height: 1.55;
		color: var(--sl-color-gray-2);
	}
	.plate .credit {
		font-size: 0.6875rem;
		color: var(--sl-color-gray-3);
	}

	/* ---------- Steps: a numbered checklist of cards, one brand hue each ---------- */
	.steps {
		display: grid;
		gap: 1rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	@media (min-width: 36rem) {
		.steps {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	@media (min-width: 64rem) {
		.steps {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}
	}
	/* Krishnachura, marigold, bottle green and river, then round again. */
	.steps li {
		display: flex;
		--hue: var(--sl-color-accent);
		--hue-low: var(--sl-color-accent-low);
		--hue-high: var(--sl-color-accent-high);
	}
	.steps li:nth-child(4n + 2) {
		--hue: var(--sl-color-orange);
		--hue-low: var(--sl-color-orange-low);
		--hue-high: var(--sl-color-orange-high);
	}
	.steps li:nth-child(4n + 3) {
		--hue: var(--sl-color-green);
		--hue-low: var(--sl-color-green-low);
		--hue-high: var(--sl-color-green-high);
	}
	.steps li:nth-child(4n + 4) {
		--hue: var(--sl-color-blue);
		--hue-low: var(--sl-color-blue-low);
		--hue-high: var(--sl-color-blue-high);
	}
	.step {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		width: 100%;
		padding: 1.25rem 1.25rem 3.25rem;
		overflow: hidden;
		border: 1px solid var(--sl-color-hairline-light);
		border-radius: var(--vd-radius-lg);
		background: var(--vd-surface);
		box-shadow: var(--sl-shadow-sm);
		color: inherit;
		text-decoration: none;
		transition: transform var(--vd-duration) var(--vd-ease), box-shadow var(--vd-duration) var(--vd-ease),
			border-color var(--vd-duration) var(--vd-ease);
	}
	/* A strip of the card's hue along the top edge, which thickens on hover. */
	.step::before {
		content: '';
		position: absolute;
		inset: 0 0 auto;
		height: 3px;
		background: var(--hue);
		transition: height var(--vd-duration) var(--vd-ease);
	}
	.step:hover,
	.step:focus-visible {
		transform: translateY(-2px);
		border-color: var(--hue);
		box-shadow: var(--sl-shadow-md);
	}
	.step:hover::before,
	.step:focus-visible::before {
		height: 5px;
	}
	.step-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 0.5rem;
	}
	.badge {
		display: grid;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		border-radius: 50%;
		background: var(--hue-low);
		color: var(--hue-high);
		transition: background-color var(--vd-duration) var(--vd-ease), color var(--vd-duration) var(--vd-ease);
	}
	.step:hover .badge,
	.step:focus-visible .badge {
		background: var(--hue);
		color: var(--vd-surface);
	}
	.number {
		font-family: var(--vd-font-display);
		font-size: var(--sl-text-2xl);
		font-weight: 700;
		line-height: 1;
		letter-spacing: -0.04em;
		font-variant-numeric: tabular-nums;
		color: var(--sl-color-gray-5);
	}
	.step h3 {
		margin: 0;
		font-family: var(--vd-font-display);
		font-size: var(--sl-text-lg);
		font-weight: 700;
		line-height: 1.25;
		letter-spacing: -0.01em;
		color: var(--sl-color-white);
		text-wrap: balance;
	}
	.step p {
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 3;
		overflow: hidden;
		margin: 0;
		font-size: var(--sl-text-sm);
		line-height: 1.55;
		color: var(--sl-color-gray-2);
		text-wrap: pretty;
	}
	.arrow {
		position: absolute;
		left: 1.25rem;
		bottom: 1.125rem;
		display: flex;
		color: var(--hue-high);
		transition: transform var(--vd-duration) var(--vd-ease);
	}
	.step:hover .arrow,
	.step:focus-visible .arrow {
		transform: translateX(4px);
	}
	/* On phones each step is a compact row: the icon beside the text, the arrow at the end, no number. */
	@media (max-width: 35.99rem) {
		.step {
			display: grid;
			grid-template-columns: auto minmax(0, 1fr);
			gap: 0.25rem 1rem;
			padding: 1.125rem 3rem 1.125rem 1rem;
		}
		.step-top {
			grid-row: span 2;
			align-self: start;
			margin: 0;
		}
		.number {
			display: none;
		}
		.arrow {
			top: 50%;
			right: 1rem;
			bottom: auto;
			left: auto;
			translate: 0 -50%;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.plate-photo,
		.step,
		.step::before,
		.badge,
		.arrow {
			transition: none;
		}
		.plate:hover .plate-photo,
		.plate:focus-visible .plate-photo,
		.step:hover,
		.step:focus-visible,
		.step:hover .arrow,
		.step:focus-visible .arrow {
			transform: none;
		}
	}
</style>
