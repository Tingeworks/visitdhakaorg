---
// Grid for HomeCards: one column on phones, two on tablets, `columns` on wide screens. Fixed counts (rather than
// auto-fill) keep rows full, so a section of four cards shows as 2 × 2 or 4 × 1, never 3 + 1.
interface Props {
	columns?: 2 | 3 | 4;
}

const { columns = 3 } = Astro.props;
---

<div class="grid" style={`--columns: ${columns}`}>
	<slot />
</div>

<style>
	.grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 1rem;
	}
	@media (min-width: 36rem) {
		.grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	@media (min-width: 64rem) {
		.grid {
			grid-template-columns: repeat(var(--columns), minmax(0, 1fr));
		}
	}
</style>
