---
// A photo tile for the homepage: a page's cover photo with its title over a dark wash at the bottom, a short chip above
// the title, and the description unfolding on hover or focus. The photo credit sits in the top corner, because the
// licence page promises a credit with every photo. The tile's shape comes from `--tile-aspect`, set by the layouts in
// PageCards, so the same tile is a landscape card in the mosaic, a portrait one in the rail and a wide panel.
interface Props {
	title: string;
	href: string;
	image: string;
	imageAlt?: string;
	imageCredit?: string;
	/** A short label above the title, such as the page's tags or its best time. */
	eyebrow?: string;
	description?: string;
	/** `lg` for the lead tile and wide panels: bigger type and padding, and the description always shows on touch screens. */
	size?: 'md' | 'lg';
	/** The stored photo's size, for the image's width and height attributes. */
	width?: number;
	height?: number;
	class?: string;
}

const {
	title,
	href,
	image,
	imageAlt = '',
	imageCredit,
	eyebrow,
	description,
	size = 'md',
	width = 1200,
	height = 800,
	class: className,
} = Astro.props;
---

<a class:list={['tile', 'vd-reveal', size, className]} href={href}>
	<img src={image} alt={imageAlt} width={width} height={height} loading="lazy" decoding="async" />
	<div class="text">
		{eyebrow && <span class="chip">{eyebrow}</span>}
		<h3 class="title">{title}</h3>
		{description && <p class="description">{description}</p>}
	</div>
	{imageCredit && <span class="credit">{imageCredit}</span>}
</a>

<style>
	.tile {
		position: relative;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		aspect-ratio: var(--tile-aspect, 3 / 2);
		overflow: hidden;
		isolation: isolate;
		border-radius: var(--vd-radius-lg);
		background: var(--sl-color-gray-6);
		box-shadow: var(--sl-shadow-sm);
		color: #f4f4f8;
		text-decoration: none;
		transition: transform var(--vd-duration) var(--vd-ease), box-shadow var(--vd-duration) var(--vd-ease);
	}
	.tile img {
		position: absolute;
		inset: 0;
		z-index: -2;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 900ms var(--vd-ease);
	}
	/* Two layers over the photo: a wash in the hero's navy so the text reads, and faint vertical ribs that appear on
	   hover, an echo of the fluted glass over the hero photo. */
	.tile::before,
	.tile::after {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		pointer-events: none;
	}
	.tile::before {
		background: linear-gradient(
			to top,
			rgb(1 7 20 / 0.84) 0%,
			rgb(1 7 20 / 0.44) 36%,
			rgb(1 7 20 / 0.08) 62%,
			rgb(1 7 20 / 0) 100%
		);
	}
	.tile::after {
		background: repeating-linear-gradient(90deg, rgb(244 244 248 / 0.09) 0 1px, rgb(244 244 248 / 0) 1px 14px);
		opacity: 0;
		transition: opacity 400ms var(--vd-ease);
	}
	.tile:hover,
	.tile:focus-visible {
		transform: translateY(-2px);
		box-shadow: var(--sl-shadow-lg);
	}
	.tile:hover img,
	.tile:focus-visible img {
		transform: scale(1.05);
	}
	.tile:hover::after,
	.tile:focus-visible::after {
		opacity: 1;
	}

	.text {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.45rem;
		padding: 1.125rem;
	}
	.lg .text {
		padding: 1.5rem;
	}
	.chip {
		padding: 0.2rem 0.55rem;
		border-radius: var(--vd-radius-sm);
		background: rgb(244 244 248 / 0.16);
		backdrop-filter: blur(8px);
		font-size: var(--sl-text-2xs);
		font-weight: 600;
		line-height: 1.5;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	/* `.tile .title` rather than `.title`, to outrank the Markdown heading colour in custom.css, which is dark in light
	   mode and would put navy text on the navy wash. */
	.tile .title {
		margin: 0;
		font-family: var(--vd-font-display);
		font-size: var(--sl-text-xl);
		font-weight: 700;
		line-height: 1.15;
		letter-spacing: -0.02em;
		color: #f4f4f8;
		text-shadow: 0 1px 2px rgb(1 7 20 / 0.45);
		text-wrap: balance;
	}
	.lg .title {
		font-size: clamp(1.75rem, 1.2rem + 2vw, 2.75rem);
		letter-spacing: -0.03em;
	}
	/* The description unfolds under the title on hover or focus. On touch screens only the large tiles show it, so the
	   grid stays mostly pictures. */
	.description {
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		overflow: hidden;
		max-height: 0;
		margin: 0;
		font-size: var(--sl-text-sm);
		line-height: 1.5;
		color: rgb(244 244 248 / 0.88);
		opacity: 0;
		translate: 0 0.4rem;
		transition: max-height 400ms var(--vd-ease), opacity 300ms var(--vd-ease), translate 400ms var(--vd-ease);
	}
	.tile:hover .description,
	.tile:focus-visible .description {
		max-height: 3.2em;
		opacity: 1;
		translate: 0 0;
	}
	@media (hover: none) {
		.lg .description {
			max-height: 3.2em;
			opacity: 1;
			translate: 0 0;
		}
	}
	.credit {
		position: absolute;
		top: 0.625rem;
		right: 0.75rem;
		max-width: 70%;
		font-size: 0.625rem;
		line-height: 1.3;
		text-align: right;
		color: rgb(244 244 248 / 0.75);
		text-shadow: 0 1px 2px rgb(1 7 20 / 0.7);
	}
	@media (prefers-reduced-motion: reduce) {
		.tile,
		.tile img,
		.tile::after,
		.description {
			transition: none;
		}
		.tile:hover,
		.tile:focus-visible,
		.tile:hover img,
		.tile:focus-visible img {
			transform: none;
		}
	}
</style>
