---
// The display name form for optional sign-in (#59): a new account's first name, in the editor and on the account page,
// and a new name on the account page. src/scripts/account.ts (nameForm) wires it up. Extra buttons go in the slot,
// next to "Save name". It sits inside a `.vd-form` element, which styles it (src/styles/edit-form.css).
const { t } = Astro.locals;
---

<p>{t('edit.chooseNameText')}</p>
<form id="account-name-form" novalidate>
	<div class="field">
		<label for="account-new-name">{t('edit.newNameLabel')}</label>
		<input id="account-new-name" type="text" autocomplete="nickname" maxlength="80" aria-describedby="account-new-name-error" />
		<p id="account-new-name-error" class="field-error" hidden></p>
	</div>
	<div class="actions">
		<button type="submit" id="account-save-name">
			{t('edit.saveName')}
		</button>
		<slot />
	</div>
</form>
