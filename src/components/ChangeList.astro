---
// A list of commits to pages, grouped by day in Dhaka time, newest first: Recent changes and contributor profile pages
// (#62). Each change names the pages it touched, in the reader's language where they exist, and links to its commit.
// Recent changes shows each author, linked to their profile for a signed-in edit. A profile shows each edit's summary.
import { repoUrl, type Change, type ChangedFile } from '../lib/changes';
import { localizedPages, localizePath, translatedLocales } from '../lib/i18n';
import { profileIds, profileUrl } from '../lib/profiles';

interface Props {
	changes: Change[];
	locale: string | undefined;
	/** `recent` shows authors, `profile` shows edit summaries. */
	variant: 'recent' | 'profile';
}

const { changes, locale, variant } = Astro.props;
const { t } = Astro.locals;
const lang = locale === 'bn' ? 'bn-BD' : 'en-GB';
const timeZone = 'Asia/Dhaka';

// Page titles in each language, to name the pages a change touched. A change to a Bangla file links to the Bangla page.
// A change to an English file links to the page in this page's language, which shows the English text where there is
// no translation. Changes to a translation are tagged with its language when listed in another language.
const titles = new Map<string | undefined, Map<string, string>>();
for (const fileLocale of [undefined, ...translatedLocales]) {
	titles.set(fileLocale, new Map((await localizedPages(fileLocale)).map((page) => [page.slug, page.data.title])));
}
const languageNames: Record<string, string> = { bn: 'বাংলা' };
const profiles = variant === 'recent' ? await profileIds() : new Set<number>();

const pageOf = (file: ChangedFile) => {
	const title = titles.get(file.locale)?.get(file.slug);
	const href = localizePath(file.slug ? `/${file.slug}/` : '/', file.locale ?? locale);
	const language = file.locale && file.locale !== locale ? languageNames[file.locale] : undefined;
	return { title: title ?? (file.slug || '/'), href: file.status !== 'deleted' && title ? href : undefined, language };
};

const maxPages = 5;
const dayKey = new Intl.DateTimeFormat('en-CA', { timeZone, year: 'numeric', month: '2-digit', day: '2-digit' });
const dayName = new Intl.DateTimeFormat(lang, { timeZone, dateStyle: 'full' });
const time = new Intl.DateTimeFormat(lang, { timeZone, hour: '2-digit', minute: '2-digit', hourCycle: 'h23' });
const number = new Intl.NumberFormat(lang);

const days = new Map<string, Change[]>();
for (const change of changes) {
	const key = dayKey.format(change.date);
	days.set(key, [...(days.get(key) ?? []), change]);
}
---

{
	[...days.values()].map((dayChanges) => (
		<section>
			<h2>{dayName.format(dayChanges[0].date)}</h2>
			<ul class="changes">
				{dayChanges.map((change) => {
					const pages = change.files.map(pageOf);
					const profile = change.account !== undefined && profiles.has(change.account);
					return (
						<li>
							<time datetime={change.date.toISOString()}>{time.format(change.date)}</time>{' '}
							<span class="pages">
								{pages.slice(0, maxPages).map((page, index) => (
									<>
										{index > 0 && ', '}
										{page.href ? <a href={page.href}>{page.title}</a> : <span>{page.title}</span>}
										{page.language && <span class="tag"> ({page.language})</span>}
									</>
								))}
								{pages.length > maxPages && ` ${t('recentChanges.more', { n: number.format(pages.length - maxPages) })}`}
							</span>
							<span class="detail">
								{' · '}
								<a href={`${repoUrl}/commit/${change.hash}`}>
									{variant === 'profile' ? change.summary || t('profile.noSummary') : change.subject}
								</a>
								{variant === 'recent' && (
									<>
										{' · '}
										{profile ? <a href={profileUrl(change.account!, locale)}>{change.author}</a> : change.author}
									</>
								)}
							</span>
						</li>
					);
				})}
			</ul>
		</section>
	))
}

<style>
	.changes {
		padding-inline-start: 1.25rem;
	}

	time,
	.tag,
	.detail {
		color: var(--sl-color-gray-3);
	}

	time {
		font-variant-numeric: tabular-nums;
	}

	.detail a {
		color: inherit;
	}
</style>
